# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or your own replica set). Example shape only:
MONGODB_URI=mongodb://USERNAME:PASSWORD@host1.example.mongodb.net:27017,host2.example.mongodb.net:27017/?tls=true&authSource=admin&replicaSet=YOUR_REPLICA_SET
MONGODB_DB=myvault

# Exact origin the app is served from (used for the CSRF origin check).
APP_URL=http://localhost:3000

# Random secret for fake pre-login salts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRELOGIN_HMAC_KEY=change-me-to-a-random-32-byte-base64-string

REGISTRATION_ENABLED=false
AUDIT_RETENTION_DAYS=90
